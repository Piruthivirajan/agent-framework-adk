# Copy to .env (gitignored) and fill in. Never commit real values.
# Used by `./mvnw spring-boot:run` (the app reads .env) and by docker-compose.prod.yml (compose reads it).

# ---- required ----------------------------------------------------------------------------------------
# Google AI Studio key for Gemini (chat model and embeddings).
GOOGLE_API_KEY=your-gemini-api-key

# One shared password that protects the whole application. Empty = open (fine on a laptop only).
# Choose a long one for any reachable host.
AGENTFW_DEMO_PASSWORD=

# ---- deployment (docker-compose.prod.yml; scripts/deploy.sh fills DOMAIN, APP_UID and APP_GID if empty) --
# Public host name. Without a domain: <public-ip-with-dashes>.sslip.io, for example 203-0-113-10.sslip.io.
DOMAIN=
# Let's Encrypt sends certificate expiry notices here.
ACME_EMAIL=
# Owner of ./corpus on the host, so that "Add to knowledge base" can write there.
APP_UID=
APP_GID=

# ---- optional ----------------------------------------------------------------------------------------
# Set to "demo" to also start the demo MCP server (docker-compose.prod.yml).
COMPOSE_PROFILES=
# Token the demo MCP server expects as "Authorization: Bearer <token>".
DEMO_MCP_TOKEN=demo-secret
# Hosts that may be used as MCP server addresses although they are on a private network (SSRF guard).
# Docker Compose with the demo profile: demo-mcp.  On a laptop with the demo server: localhost.
AGENTFW_MCP_ALLOWED_HOSTS=
# Encrypts the credentials of MCP servers saved from the settings page, so they survive a restart.
# base64 of 32 random bytes: openssl rand -base64 32 (scripts/deploy.sh generates one if this is empty).
# Empty = servers stay in memory only and a restart forgets them. Keep this key: a new one cannot read old data.
AGENTFW_MCP_SECRET_KEY=
